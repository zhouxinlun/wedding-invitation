.motion-frame{position:relative;width:100%;overflow:hidden;border-radius:330rpx 330rpx 16rpx 16rpx;background:#607774;isolation:isolate}.motion-still{display:block;width:100%}.motion-video{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .24s;pointer-events:none}.motion-visible{opacity:1;pointer-events:auto}.motion-retry{position:absolute;right:20rpx;bottom:20rpx;background:#173d39df;color:#f1dbb5;border:1rpx solid #c8ad7f77;border-radius:40rpx;padding:14rpx 22rpx;margin:0;width:auto;min-height:82rpx;font-size:22rpx;line-height:1.6}.motion-retry::after{border:0}@media(prefers-reduced-motion:reduce){.motion-video{display:none}.motion-retry{display:none}}

<view class="b-tag-view blessings {{motionPaused ? 'b-paused' : ''}}">
  <view class="b-tag-view b-heading"><view class="b-tag-view b-title">有你们，欢喜成双。</view><view class="b-tag-view b-intro">见字如面，见你欢喜。</view></view>
  <button class="b-tag-button b-letter-card" bindtap="openForm" aria-label="写一份祝福"><image class="b-tag-image b-letter-vine" src="/assets/rose-vines/vine-07.png" mode="aspectFit" aria-hidden="true"/><view class="b-tag-view b-letter-to">致 小妮与新沦</view><view class="b-tag-view b-letter-title">这份欢喜，<text class="b-tag-text">就差你的一笔。</text></view><view class="b-tag-view b-letter-footer"><text class="b-tag-text">写祝福，也分享照片</text><text class="b-tag-text b-seal">寄 ♡</text></view></button>
  <view class="b-tag-view b-feed-heading"><text class="b-tag-text">亲友祝福</text><text class="b-tag-text b-feed-order">最新心意在前</text></view>
  <view class="b-tag-view b-feed-frame">
    <scroll-view class="b-feed-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}" scroll-anchoring scroll-top="{{feedTop}}">
      <view wx:if="{{!ready}}" class="b-tag-view b-empty"><text class="b-tag-text b-empty-heart">♡</text><text class="b-tag-text">{{status || '正在打开亲友来信…'}}</text><button class="b-tag-button b-retry" bindtap="retry">重新连接 ↗</button></view>
      <view wx:elif="{{loading && postCount === 0}}" class="b-tag-view b-empty">正在打开一封封心意…</view>
      <view wx:elif="{{postCount === 0}}" class="b-tag-view b-empty"><text class="b-tag-text b-empty-heart">♡</text><text class="b-tag-text">第一份祝福，留给你。</text></view>
      <view wx:if="{{error && !formOpen}}" class="b-tag-view b-error" bindtap="retry">{{error}} · 轻触重试</view>
      <view class="b-tag-view b-posts">
        <view wx:for="{{items}}" wx:key="id" class="b-tag-view b-post">
          <view class="b-tag-view b-post-head"><text class="b-tag-text b-avatar">{{item.emoji || '♡'}}</text><view class="b-tag-view b-author"><text class="b-tag-text">{{item.name}}</text><text class="b-tag-text b-time">{{item.dateLabel}}</text></view><text class="b-tag-text b-post-flower" aria-hidden="true">✧</text></view>
          <view wx:if="{{item.text}}" class="b-tag-view b-post-text" data-id="{{item.id}}" bindtap="openReply" role="button" aria-label="回复{{item.name}}">{{item.text}}</view>
          <view wx:if="{{item.photoViews.length}}" class="b-tag-view b-photo-grid">
            <view class="b-tag-view b-published-photo" wx:for="{{item.photoViews}}" wx:for-item="photo" wx:key="key"><image class="b-tag-image b-natural-photo" src="{{photo.url}}" mode="aspectFit" style="width:{{photo.width}}rpx;height:{{photo.height}}rpx" lazy-load data-id="{{item.id}}" data-index="{{photo.index}}" bindload="photoLoaded" bindtap="preview" aria-label="查看{{item.name}}分享的第{{photo.index + 1}}张照片"/><button wx:if="{{item.own}}" class="b-tag-button b-delete-photo" data-kind="photo" data-id="{{item.id}}" data-photo-key="{{photo.key}}" catchtap="deleteContent" disabled="{{deleting}}" aria-label="删除自己分享的第{{photo.index + 1}}张照片">删除照片</button></view>
          </view>
          <view class="b-tag-view b-post-actions"><button wx:if="{{item.own}}" class="b-tag-button b-delete-action" data-kind="post" data-id="{{item.id}}" bindtap="deleteContent" disabled="{{deleting}}">删除祝福</button><button class="b-tag-button b-reply-action" data-id="{{item.id}}" bindtap="openReply">♡ 回复</button></view>
          <view wx:if="{{item.replies.length}}" class="b-tag-view b-replies">
            <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="b-tag-view b-reply-line" data-id="{{item.id}}" data-reply-id="{{reply.id}}" bindtap="openReply" role="button" aria-label="回复{{reply.name}}"><view class="b-tag-view b-reply-copy"><text class="b-tag-text b-reply-name">{{reply.name}}</text><text class="b-tag-text b-reply-word"> 回复 </text><text class="b-tag-text b-reply-name">{{reply.replyToName}}</text><text class="b-tag-text">：{{reply.text}}</text></view><button wx:if="{{reply.own}}" class="b-tag-button b-delete-reply" data-kind="reply" data-id="{{item.id}}" data-reply-id="{{reply.id}}" catchtap="deleteContent" disabled="{{deleting}}" aria-label="删除自己这条回复">删除</button></view>
          </view>
        </view>
      </view>
      <view wx:if="{{postCount > 0}}" class="b-tag-view b-list-end">{{postCount >= 50 ? '最近50份心意，满满都是祝福' : '每一句，都被好好珍藏'}} ♡</view>
    </scroll-view>
  </view><view class="b-tag-view b-footnote">祝福在这里相聚，良辰还在下方继续。</view>
  <view class="b-tag-view b-snow" aria-hidden="true"><view wx:for="{{flakes}}" wx:key="id" class="b-tag-view b-flake b-flake-{{item.variant}}" data-id="{{item.id}}" data-slot="{{item.slot}}" bindanimationend="snowEnded" style="left:{{item.left}}%;width:{{item.width}}rpx;height:{{item.height}}rpx;--drift:{{item.drift}}rpx;--tilt:{{item.rotation}}deg;--alpha:{{item.opacity}};animation-duration:{{item.duration}}s"><view class="b-tag-view b-thread" style="width:{{item.width}}rpx;height:{{item.height}}rpx"><block wx:for="{{item.chars}}" wx:for-item="letter" wx:key="id"><view wx:if="{{letter.link}}" class="b-tag-view b-link" style="left:{{letter.linkX}}rpx;top:{{letter.linkY}}rpx;width:{{letter.linkLength}}rpx;transform:rotate({{letter.linkTurn}}deg)"/><text class="b-tag-text b-letter" style="left:{{letter.x}}rpx;top:{{letter.y}}rpx;transform:rotate({{letter.turn}}deg)">{{letter.glyph}}</text></block><text class="b-tag-text b-thread-end" style="left:{{item.width - 25}}rpx;top:{{item.height - 24}}rpx">{{item.emoji}}</text></view></view></view>
  <view wx:if="{{bursts.length}}" class="b-tag-view b-burst" aria-hidden="true"><text class="b-tag-text" wx:for="{{bursts}}" wx:key="id" style="--x:{{item.x}}rpx;--y:{{item.y}}rpx;animation-delay:{{item.delay}}s">{{item.glyph}}</text></view>
  <button wx:if="{{!formOpen && !replyOpen && !paused}}" class="b-tag-button b-fab" bindtap="openForm" aria-label="写祝福或分享照片"><text class="b-tag-text">♡</text>送祝福</button>
  <view wx:if="{{formOpen}}" class="b-tag-view b-overlay" catchtouchmove="hold"><view class="b-tag-view b-sheet"><view class="b-tag-view b-sheet-head"><view class="b-tag-view"><text class="b-tag-text b-sheet-to">TO 小妮 & 新沦</text><view class="b-tag-view b-sheet-title">把欢喜，写给你们。</view></view><button class="b-tag-button b-close" bindtap="closeForm" disabled="{{busy}}" aria-label="关闭祝福窗口">×</button></view>
    <scroll-view scroll-y class="b-form-scroll" enhanced show-scrollbar="{{true}}"><view class="b-tag-view b-form-body">
      <label class="b-label b-name-label"><text class="b-tag-text">落款</text><input type="nickname" class="b-input" placeholder="你的微信昵称或称呼" maxlength="20" value="{{name}}" bindinput="inputName" bindblur="inputName" disabled="{{busy || uncertain}}"/></label>
      <label class="b-label b-message-label"><text class="b-tag-text">想对你们说</text><textarea class="b-textarea" placeholder="愿你们有说不完的话，也有看不完的风景。" maxlength="160" fixed value="{{text}}" bindinput="inputText" disabled="{{busy || uncertain}}" adjust-position/><text class="b-tag-text b-counter">{{textCount}} / 160</text></label>
      <view class="b-tag-view b-emoji-row"><button wx:for="{{emojis}}" wx:key="*this" class="b-tag-button" data-emoji="{{item}}" bindtap="chooseEmoji" disabled="{{busy || uncertain}}" aria-label="加入正文 {{item}}">{{item}}</button></view>
      <view class="b-tag-view b-photo-label"><text class="b-tag-text">附上你的独家收藏</text><text class="b-tag-text b-optional">{{formPhotos.length}} / 3 张</text></view><view class="b-tag-view b-photo-note">新郎手机相册穷尽，请尽情上传新娘的丑照</view>
      <view class="b-tag-view b-photo-picker"><view wx:for="{{formPhotos}}" wx:key="path" class="b-tag-view b-picked"><image class="b-tag-image" src="{{item.path}}" mode="aspectFit" style="width:{{item.width || 160}}rpx;height:{{item.height || 160}}rpx" data-index="{{index}}" bindload="pickedPhotoLoaded"/><button class="b-tag-button" data-index="{{index}}" bindtap="removePhoto" disabled="{{busy || uncertain}}" aria-label="移除第{{index+1}}张照片">×</button></view><button wx:if="{{formPhotos.length < 3}}" class="b-tag-button b-add-photo" bindtap="choosePhotos" disabled="{{busy || uncertain}}"><text class="b-tag-text">＋</text><text class="b-tag-text">添张照片</text></button></view>
      <view wx:if="{{error}}" class="b-tag-view b-error">{{error}}</view><view wx:if="{{!ready}}" class="b-tag-view b-error">暂未连接，请稍后重试</view>
    </view></scroll-view><view class="b-tag-view b-send-footer"><view wx:if="{{busy}}" class="b-tag-view b-loading" role="status"><view class="b-tag-view b-loading-spinner"/><view class="b-tag-view"><text class="b-tag-text">{{progress}}</text><text class="b-tag-text b-loading-hint">请稍候，完成后会自动显示</text></view></view><text wx:else class="b-tag-text b-send-note">发送后直接展示给亲友</text><button class="b-tag-button b-send {{busy || !ready ? 'b-disabled' : ''}}" bindtap="submit" loading="{{busy}}" disabled="{{busy || !ready}}">{{busy ? progress : uncertain ? '重试，核对送达结果' : '寄出这份欢喜'}}<text class="b-tag-text" wx:if="{{!busy}}"> ↗</text></button></view>
  </view></view>

  <view wx:if="{{replyOpen}}" class="b-tag-view b-overlay" catchtouchmove="hold">
    <view class="b-tag-view b-sheet b-reply-sheet">
      <view class="b-tag-view b-sheet-head"><view class="b-tag-view"><text class="b-tag-text b-sheet-to">一来一往，都是欢喜</text><view class="b-tag-view b-sheet-title">回复 {{replyTarget.name}}</view></view><button class="b-tag-button b-close" bindtap="closeReply" disabled="{{replyBusy}}" aria-label="关闭回复窗口">×</button></view>
      <form bindsubmit="submitReply">
      <scroll-view scroll-y class="b-form-scroll b-reply-form-scroll" enhanced>
        <view class="b-tag-view b-form-body">
          <label class="b-label b-name-label"><text class="b-tag-text">落款</text><input name="name" type="nickname" class="b-input" placeholder="你的微信昵称或称呼" maxlength="20" value="{{name}}" bindinput="inputName" bindblur="inputName" disabled="{{replyBusy || replyUncertain}}"/></label>
          <label class="b-label b-message-label"><text class="b-tag-text">回复 {{replyTarget.name}}</text><textarea name="text" class="b-textarea" placeholder="接住这份心意，也说说你的欢喜…" maxlength="160" fixed value="{{replyText}}" bindinput="inputReply" disabled="{{replyBusy || replyUncertain}}" adjust-position/><text class="b-tag-text b-counter">{{replyCount}} / 160</text></label>
          <view class="b-tag-view b-emoji-row"><button wx:for="{{emojis}}" wx:key="*this" class="b-tag-button" data-emoji="{{item}}" bindtap="replyEmoji" disabled="{{replyBusy || replyUncertain}}" aria-label="加入回复 {{item}}">{{item}}</button></view>
        </view>
      </scroll-view>
      <view class="b-tag-view b-send-footer"><view wx:if="{{replyError}}" class="b-tag-view b-error" role="alert">{{replyError}}</view><view wx:if="{{replyBusy}}" class="b-tag-view b-loading" role="status"><view class="b-tag-view b-loading-spinner"/><view class="b-tag-view"><text class="b-tag-text">{{replyProgress}}</text><text class="b-tag-text b-loading-hint">请稍候，完成后会自动显示</text></view></view><text wx:else class="b-tag-text b-send-note">这句心意，会接在原祝福下面</text><button class="b-tag-button b-send {{replyBusy || !ready ? 'b-disabled' : ''}}" form-type="submit" loading="{{replyBusy}}" disabled="{{replyBusy || !ready}}">{{replyBusy ? '正在回复…' : replyUncertain ? '重试，核对送达结果' : '送出回复 ↗'}}</button></view></form>
    </view>
  </view>
</view>

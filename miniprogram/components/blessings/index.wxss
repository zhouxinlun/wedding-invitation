/* Reuse invitation colours and type. Layers: snow 8, quick action 11, success 35, compose 40. */
.blessings{position:relative;color:#f6ead8}.blessings .b-tag-button{box-sizing:border-box;margin:0;width:auto;font-family:inherit;line-height:1.6}.blessings .b-tag-button::after{border:0}.blessings .b-tag-button:active{transform:scale(.98)}
.b-heading{padding:12rpx 0 36rpx;text-align:center}.b-title{font-family:'Wedding Display','Songti SC',serif;font-size:48rpx;color:#eed1a0;line-height:1.5}.b-intro{font-size:24rpx;letter-spacing:3rpx;color:#c4d4c8;margin-top:16rpx}
.blessings .b-letter-card{position:relative;display:block;width:100%;padding:34rpx 34rpx 25rpx;text-align:left;overflow:hidden;border:1rpx solid #bda17088;border-radius:12rpx;background:#1b4a49;color:#f3ddbb;box-shadow:5rpx 8rpx 0 #0b313233}.b-letter-card::before{content:'';position:absolute;inset:9rpx;border:1rpx solid #bda17033;border-radius:6rpx;pointer-events:none}.b-letter-vine{position:absolute;right:-78rpx;top:-40rpx;width:390rpx;height:240rpx;opacity:.72;transform:rotate(-24deg);pointer-events:none}.b-letter-to{position:relative;color:#c4cfb9;font-size:21rpx;letter-spacing:2rpx}.b-letter-title{position:relative;font-family:'Songti SC',serif;font-size:40rpx;letter-spacing:3rpx;line-height:1.65;margin:23rpx 0}.b-letter-title .b-tag-text{display:block}.b-letter-footer{position:relative;display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#d0c8ab}.b-seal{display:flex;align-items:center;justify-content:center;background:#7e3d47;border:1rpx solid #dbb78777;border-radius:50%;color:#f7e0b7;width:92rpx;height:92rpx;transform:rotate(-10deg);font-family:'Songti SC',serif;font-size:28rpx}
.b-feed-heading{display:flex;justify-content:space-between;align-items:center;margin-top:52rpx;padding:0 4rpx 20rpx;font-size:29rpx;letter-spacing:2rpx;color:#f3dab4}.b-feed-order{font-size:20rpx;letter-spacing:0;color:#b9cabf}.b-feed-frame{border-top:1rpx solid #b9a77866;border-bottom:1rpx solid #b9a77844;background:#0c343733;border-radius:0 0 10rpx 10rpx;overflow:hidden}.b-feed-scroll{height:640rpx;width:100%;overscroll-behavior-y:auto;scrollbar-color:#b39d6c #1b4848;scrollbar-width:thin}.b-posts{padding:0 22rpx}.b-post{padding:30rpx 2rpx;border-bottom:1rpx solid #a7b99c26}.b-post-head{display:flex;align-items:center;gap:16rpx}.b-avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;border:1rpx solid #b8a6794d;border-radius:22rpx;background:#23504d;font-size:29rpx;flex-shrink:0}.b-author{display:flex;flex-direction:column;flex:1;min-width:0;font-size:25rpx;color:#f4dfbc;overflow-wrap:anywhere}.b-time{font-size:19rpx;line-height:1.6;color:#b3c6b8;margin-top:2rpx}.b-post-flower{font-size:30rpx;color:#b79f73}.b-post-text{font-size:27rpx;color:#eee8d9;line-height:1.9;margin:18rpx 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.b-photo-grid{display:flex;flex-wrap:wrap;align-items:flex-start;gap:12rpx;margin-top:20rpx}.b-photo-grid .b-tag-image{display:block;max-width:100%;border-radius:8rpx;background:transparent;flex-shrink:0}.b-list-end{text-align:center;font-size:20rpx;color:#bbcab8;padding:30rpx 0}.b-footnote{text-align:center;font-size:20rpx;color:#b4c5b5;line-height:1.8;padding:22rpx 10rpx}.b-empty{min-height:450rpx;padding:40rpx 24rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;text-align:center;font-size:24rpx;color:#c2d0bd}.b-empty-heart{font-size:72rpx;color:#cbb083}.b-retry{color:#edd4a5;background:transparent;border-bottom:1rpx solid #ba9b6b;border-radius:0;padding:16rpx;font-size:23rpx;min-height:80rpx}.b-error{font-size:24rpx;color:#ffd2bd;line-height:1.8;padding:18rpx 20rpx}
/* Fine character links, never opaque cards. Full messages stay in the readable feed. */
.b-snow{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:8}.b-flake{position:absolute;top:-320rpx;pointer-events:none;animation:b-fall 22s linear forwards;opacity:0;color:#f6dca8;will-change:transform,opacity}.b-thread{position:relative}.b-letter{position:absolute;font-family:'Songti SC',serif;font-size:25rpx;line-height:30rpx;width:29rpx;height:32rpx;text-align:center;text-shadow:0 1rpx 3rpx #143c4055}.b-link{position:absolute;height:5rpx;border-bottom:1rpx solid currentColor;border-radius:0 0 50% 50%;transform-origin:0 0}.b-thread-end{position:absolute;font-size:23rpx;line-height:24rpx}.b-flake-1{color:#eebdb8}.b-flake-1 .b-link{border-bottom-style:dotted}.b-flake-2{color:#e9e9d6}.b-flake-2 .b-letter{border:1rpx solid #e9e9d65e;border-radius:50%}.b-flake-3{color:#ddc6aa}.b-flake-3 .b-letter{font-size:25rpx}.b-flake-3 .b-link{height:1rpx}.b-flake-4{color:#f0c3c5}.b-flake-4 .b-link{border-bottom-style:double;height:8rpx;border-width:3rpx}.b-flake-5{color:#cdddd3}.b-flake-5 .b-letter::after{content:'';position:absolute;width:4rpx;height:4rpx;background:currentColor;border-radius:50%;bottom:-4rpx;left:13rpx}.b-paused .b-flake{animation-play-state:paused;visibility:hidden}
@keyframes b-fall{0%{transform:translate3d(0,0,0) rotate(calc(-1 * var(--tilt)));opacity:0}16%{opacity:var(--alpha)}46%{transform:translate3d(var(--drift),54vh,0) rotate(var(--tilt));opacity:var(--alpha)}83%{opacity:var(--alpha)}100%{transform:translate3d(calc(-.5 * var(--drift)),calc(100vh + 640rpx),0) rotate(calc(-1 * var(--tilt)));opacity:0}}
.b-fab{position:fixed;right:24rpx;bottom:calc(165rpx + env(safe-area-inset-bottom));z-index:11;display:flex;gap:10rpx;align-items:center;padding:16rpx 25rpx;min-height:88rpx;border-radius:60rpx;border:1rpx solid #d8bd8f77;background:#703e47ed;color:#fae6c2;font-size:23rpx;letter-spacing:2rpx;box-shadow:0 6rpx 24rpx #082b3033}.b-fab .b-tag-text{font-size:34rpx}.b-burst{position:fixed;left:50%;top:60%;z-index:35;pointer-events:none;color:#e7ba87}.b-burst .b-tag-text{position:absolute;font-size:34rpx;animation:b-pop 1.6s ease-out both}@keyframes b-pop{0%{transform:translate(0,0) scale(.5);opacity:0}12%{opacity:.8}100%{transform:translate(var(--x),var(--y)) rotate(70deg) scale(.8);opacity:0}}
.b-overlay{position:fixed;inset:0;background:#082d30c9;z-index:40;display:flex;align-items:flex-end}.b-sheet{box-sizing:border-box;width:100%;max-height:92vh;background:#f5ebd9;color:#5c4240;border-radius:28rpx 28rpx 0 0;box-shadow:0 -16rpx 70rpx #082d3055;overflow:hidden;animation:b-open .3s ease-out}.b-sheet-head{display:flex;align-items:center;justify-content:space-between;padding:28rpx 32rpx 25rpx;border-bottom:1rpx solid #a783623d}.b-sheet-to{font-size:19rpx;letter-spacing:3rpx;color:#765b50}.b-sheet-title{font-family:'Songti SC',serif;font-size:38rpx;letter-spacing:2rpx;margin-top:10rpx;line-height:1.5}.blessings .b-close{width:80rpx;min-height:80rpx;background:transparent;color:#794c48;border:1rpx solid #ad8d7144;border-radius:50%;font-size:39rpx;padding:0;line-height:76rpx;flex-shrink:0}.b-form-scroll{height:870rpx;max-height:calc(88vh - 320rpx);min-height:250rpx}.b-form-body{padding:25rpx 32rpx 20rpx}.b-label{display:block;position:relative;font-size:23rpx;color:#654b40;line-height:1.7}.b-name-label{display:flex;align-items:center;gap:28rpx;margin-bottom:22rpx}.b-name-label>.b-tag-text{flex-shrink:0}.b-input{flex:1;min-width:0;height:78rpx;line-height:78rpx;padding:0 12rpx;font-size:27rpx;background:transparent;color:#513a35;border-bottom:1rpx solid #a8806588;box-sizing:border-box}.b-message-label{background:#fbf4e7;border-radius:10rpx;padding:22rpx 22rpx 10rpx;border:1rpx solid #c0a18266}.b-textarea{display:block;width:100%;height:192rpx;box-sizing:border-box;font-size:29rpx;color:#513a35;line-height:1.9;margin-top:12rpx;background:repeating-linear-gradient(transparent,transparent 53rpx,#b39a762d 54rpx,transparent 55rpx);padding-bottom:30rpx}.b-input::placeholder,.b-textarea::placeholder{color:#927a69}.b-counter{display:block;text-align:right;font-size:18rpx;color:#836b58;line-height:1.6}.b-emoji-row{display:flex;justify-content:space-between;gap:10rpx;margin:22rpx 0 30rpx}.blessings .b-emoji-row .b-tag-button{width:82rpx;height:82rpx;min-height:82rpx;line-height:78rpx;padding:0;border:1rpx solid #bca27d55;background:transparent;border-radius:26rpx;font-size:31rpx;color:#7c3f47}.b-emoji-row .b-tag-button.selected{border:2rpx solid #95434c;background:#edd6c5;transform:rotate(-5deg)}.b-photo-label{display:flex;justify-content:space-between;gap:12rpx;font-size:24rpx;color:#654b40}.b-optional{font-size:20rpx;color:#816b58;flex-shrink:0}.b-photo-note{font-size:23rpx;line-height:1.8;color:#865b52;margin:10rpx 0 18rpx}.b-photo-picker{display:flex;flex-wrap:wrap;align-items:flex-start;gap:22rpx;padding:5rpx 8rpx 14rpx 0}.b-picked{position:relative;padding:6rpx 6rpx 12rpx;background:#fffbf0;border:1rpx solid #c3a68177;border-radius:4rpx}.b-picked .b-tag-image{display:block;max-width:180rpx;max-height:210rpx;border-radius:2rpx}.blessings .b-picked .b-tag-button{position:absolute;right:-12rpx;top:-14rpx;width:52rpx;height:52rpx;line-height:48rpx;min-height:52rpx;padding:0;background:#77414a;color:#fff0d9;border-radius:50%;font-size:30rpx;z-index:2}.blessings .b-add-photo{width:150rpx;height:150rpx;border:1rpx dashed #a58063;background:#eee0c9;border-radius:6rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22rpx;color:#74594c;padding:0;margin:0}.b-add-photo .b-tag-text:first-child{font-size:48rpx;line-height:1.1;font-weight:200}.b-send-footer{padding:15rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#f5ebd9;border-top:1rpx solid #b6997540}.b-send-note{display:block;text-align:center;font-size:20rpx;color:#795f51;margin-bottom:12rpx}.blessings .b-send{display:block;width:100%;min-height:94rpx;border-radius:10rpx;background:#7c3f48;color:#fff0d9;padding:22rpx 16rpx;letter-spacing:3rpx;font-size:28rpx}.b-send.b-disabled{background:#baa18c;color:#fff7e9}.b-sheet .b-error{color:#9e343f;padding:12rpx 0;font-size:23rpx}@keyframes b-open{from{transform:translateY(30rpx);opacity:0}to{transform:translateY(0);opacity:1}}
@media(prefers-reduced-motion:reduce){.b-snow,.b-burst{display:none}.b-sheet{animation:none}.b-emoji-row .selected{transform:none}.blessings .b-tag-button:active{transform:none}}

/* Photos keep their shape; replies form one compact Moments-style conversation. */
.b-post-actions{display:flex;justify-content:flex-end;padding-top:12rpx}.blessings .b-reply-action{background:transparent;color:#ddc39d;border:0;padding:8rpx 14rpx;font-size:23rpx;border-radius:8rpx;min-height:66rpx}.b-replies{position:relative;background:#24505088;border-radius:8rpx;margin-top:8rpx;padding:12rpx 18rpx}.b-replies::before{content:'';position:absolute;top:-10rpx;left:32rpx;width:20rpx;height:20rpx;background:#245050;transform:rotate(45deg)}.b-reply-line{position:relative;min-height:64rpx;box-sizing:border-box;padding:10rpx 0;font-size:24rpx;line-height:1.8;color:#ecdfce;overflow-wrap:anywhere;white-space:pre-wrap}.b-reply-name{color:#edc892;font-weight:500}.b-reply-word{color:#adc4b7;font-size:22rpx}.b-reply-sheet .b-sheet-title{font-size:32rpx;overflow-wrap:anywhere}.b-reply-form-scroll{height:550rpx;max-height:calc(84vh - 340rpx)}.b-loading{display:flex;align-items:center;justify-content:center;gap:18rpx;min-height:88rpx;padding:4rpx 0 16rpx;font-size:25rpx;color:#73464a;line-height:1.6}.b-loading-hint{display:block;font-size:20rpx;color:#866958}.b-loading-spinner{width:34rpx;height:34rpx;flex-shrink:0;border:3rpx solid #c9a38766;border-top-color:#8b4450;border-radius:50%;animation:b-loading-turn .9s linear infinite}@keyframes b-loading-turn{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){.b-loading-spinner{animation:none;border-style:dotted}}

/* Author-only controls stay beside the content they remove. */
.b-post-actions{justify-content:space-between;align-items:center}.b-post-actions .b-reply-action{margin-left:auto}.blessings .b-delete-action,.blessings .b-delete-photo,.blessings .b-delete-reply{background:transparent;color:#ceb1a7;border:0;letter-spacing:0;font-size:21rpx;min-height:72rpx;padding:12rpx 8rpx;line-height:1.8;border-radius:8rpx}.b-published-photo{display:flex;flex-direction:column;align-items:flex-start;max-width:100%}.blessings .b-delete-photo{font-size:20rpx;padding:8rpx 4rpx;min-height:68rpx}.b-reply-line{display:flex;align-items:flex-start;gap:8rpx}.b-reply-copy{flex:1;min-width:0}.blessings .b-delete-reply{flex-shrink:0;font-size:20rpx;padding:10rpx 4rpx;min-width:68rpx;min-height:72rpx}.b-send-footer .b-error{text-align:center;margin-bottom:10rpx;padding:6rpx 0 10rpx}

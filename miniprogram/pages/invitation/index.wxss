.invitation-button{display:flex;align-items:center;gap:20rpx;padding:20rpx 24rpx;border-radius:24rpx;background:linear-gradient(115deg,#f3dbae,#dfbd85);border:1rpx solid #f7e5bd;color:#183c38;min-height:114rpx;box-shadow:0 7rpx 0 #0b302f,0 8rpx 0 #6c7860;margin:0;text-align:left}.button-seal{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:55rpx;height:60rpx;font-size:32rpx;background:#a74433;color:#fff0cb;border-radius:9rpx 5rpx 10rpx 5rpx;border:1rpx solid #c17350;transform:rotate(-5deg)}.button-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:5rpx}.button-title{font-size:27rpx;letter-spacing:3rpx;white-space:nowrap}.button-subtitle{font-size:18rpx;letter-spacing:1rpx;opacity:.75;white-space:nowrap}.button-arrow{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48rpx;height:48rpx;border:1rpx solid #526b5455;border-radius:50%;font-size:28rpx;line-height:1}.hero-cta{margin:32rpx 100rpx 0}.scroll-note{display:flex;align-items:center;justify-content:center;gap:16rpx;font-size:18rpx;letter-spacing:3rpx;color:#b1c3b6;margin-top:42rpx}.scroll-thread{width:1rpx;height:30rpx;background:#b29b70;position:relative}.scroll-thread::after{content:'';width:6rpx;height:6rpx;border-radius:50%;background:#e5c58e;position:absolute;left:-2rpx;animation:thread-drop 2.6s ease-in-out infinite}

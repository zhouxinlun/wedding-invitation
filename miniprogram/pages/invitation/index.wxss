.section{padding:84rpx 42rpx 12rpx}.section-kicker{display:flex;align-items:center;gap:18rpx;color:#d5b47e;font-size:17rpx;letter-spacing:3rpx;margin-bottom:24rpx}.chapter-number{display:inline-flex;align-items:center;justify-content:center;font-family:"Songti SC",serif;width:42rpx;height:42rpx;border:1rpx solid #a5875c;color:#edd7ab;border-radius:50%;font-size:23rpx}.section-title{font-size:50rpx;line-height:1.55;letter-spacing:3rpx;margin-bottom:42rpx}.us-photo{display:block;width:100%;border-radius:330rpx 330rpx 16rpx 16rpx;background:#607774}.names-details{position:relative;display:flex;align-items:center;justify-content:space-around;padding:40rpx 0;text-align:center}.names-details::after{content:'';position:absolute;bottom:0;left:0;right:0;height:1rpx;background:linear-gradient(90deg,transparent,#b36948,#e5c58e,#b36948,transparent);transform:scaleX(0);transition:transform 1.2s .3s}.is-visible .names-details::after{transform:scaleX(1)}.role{display:block;color:#bbcabb;font-size:21rpx;letter-spacing:5rpx}.person-name{display:block;font-size:40rpx;margin-top:6rpx;letter-spacing:5rpx}.heart-seal{color:#e1ba81;font-size:28rpx;border:1rpx solid #bd775a;width:52rpx;height:52rpx;border-radius:50%}.story-caption{text-align:center;color:#c9d4c5;line-height:2.1;padding:32rpx 0}.album-hint{margin-top:-25rpx;font-size:23rpx;margin-bottom:30rpx}.album-grid{display:flex;flex-wrap:wrap;justify-content:space-between;gap:30rpx}.album-item{width:calc(50% - 15rpx);transition:opacity .8s,transform .8s}.album-item:nth-child(even){padding-top:58rpx}.photo-mount{position:relative;padding:8rpx;background:#e4cfab;border-radius:8rpx;transform:rotate(-2deg);box-shadow:0 12rpx 20rpx #082c3033}.album-item:nth-child(even) .photo-mount{transform:rotate(2deg)}.photo-mount::before{content:'';position:absolute;z-index:1;top:-8rpx;left:36%;width:28%;height:22rpx;background:#c68b566b;transform:rotate(-5deg)}.album-item image{display:block;width:100%;height:420rpx;background:#56706a;border-radius:3rpx}.photo-label{font-size:18rpx;letter-spacing:2rpx;color:#d9c39d;margin-top:22rpx}
.journey{padding-top:100rpx}.event-date{font-size:34rpx;border-bottom:1rpx solid #5f7864;padding-bottom:30rpx}.timeline{display:flex;gap:32rpx;padding:34rpx 0 42rpx}.timeline-dot{width:12rpx;height:12rpx;border-radius:50%;background:#e3bd80;margin-top:35rpx;box-shadow:0 0 0 10rpx #2c5650}.time{font-family:Georgia,serif;font-size:60rpx;color:#efd4a3;line-height:1.4}.timeline .muted{font-size:24rpx;margin-top:12rpx}
.journey-card{border:1rpx solid #7b8a6d;background:#1b4948;border-radius:30rpx;overflow:hidden;box-shadow:0 18rpx 50rpx #072c2925}.journey-greeting{display:flex;gap:12rpx;justify-content:space-between;align-items:center;padding:32rpx;background:#214e48;border-bottom:1rpx solid #63816b66}.journey-greeting .eyebrow{font-size:17rpx;letter-spacing:2rpx}.greeting-title{font-size:31rpx;letter-spacing:1rpx;color:#f4dfb4;margin-top:12rpx}.postmark{display:flex;align-items:center;justify-content:center;flex-direction:column;flex-shrink:0;width:70rpx;height:80rpx;line-height:1.25;border:2rpx solid #c88b65;outline:1rpx solid #c88b6570;outline-offset:5rpx;color:#e6b086;font-size:25rpx;border-radius:50%;transform:rotate(10deg)}.destination-tabs{display:flex;gap:10rpx;padding:24rpx 26rpx;overflow-x:auto}.destination-tabs button{flex:1;min-width:130rpx;min-height:84rpx;padding:18rpx 10rpx;border-radius:50rpx;color:#dce4d2;background:#284e48;border:1rpx solid #728770;font-size:24rpx;white-space:nowrap}.destination-tabs .selected{background:#e5c58e;color:#173b37;border-color:#e5c58e}.destination-map{width:100%;height:360rpx;display:block}.destination-details{padding:34rpx 32rpx}.destination-details>.eyebrow{font-size:18rpx;color:#bccaba}.venue-name{font-size:60rpx;color:#f0d4a3;margin-top:10rpx;line-height:1.4}.venue-branch{font-size:25rpx;letter-spacing:2rpx;margin-top:6rpx}.venue-address{color:#d0d9c9;font-size:24rpx;margin-top:18rpx;line-height:1.8}.distance-card{display:flex;align-items:center;gap:14rpx;justify-content:space-between;border-top:1rpx solid #6b836866;border-bottom:1rpx solid #6b836866;padding:26rpx 0;margin-top:26rpx}.distance-card>view{flex:1;min-width:0}.distance-number{font-size:28rpx;color:#f0d7a6}.distance-note{font-size:19rpx;color:#bdcbbb;margin-top:7rpx}.distance-button{margin:0;flex-shrink:0;background:#35584c;color:#f4dfb2;border:1rpx solid #718768;border-radius:50rpx;font-size:21rpx;min-height:84rpx;padding:20rpx 18rpx}.distance-button[disabled]{color:#d
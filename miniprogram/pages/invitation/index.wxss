.farewell{text-align:center;padding:90rpx 0 40rpx}.farewell-title{font-size:36rpx;margin:20rpx 0 16rpx}.farewell .muted{font-size:24rpx}.share-btn{display:flex;align-items:center;justify-content:center;gap:24rpx;margin:42rpx auto;max-width:440rpx;border-radius:50rpx}.share-btn .button-arrow{border-color:#a8ad8260}.footer-date{font-size:18rpx;letter-spacing:2rpx;color:#c0cdbb}
.joy-snow{pointer-events:none;position:fixed;inset:0;overflow:hidden;z-index:3}.snow-piece{position:absolute;top:-70rpx;color:#e5c58e;font-family:"Songti SC",serif;opacity:0;animation-name:joy-fall;animation-timing-function:linear;animation-iteration-count:infinite;will-change:transform}.snow-piece:nth-child(3n + 1){color:#d6855c}
.reveal-section{opacity:0;transform:translateY(40rpx);transition:opacity .8s,transform .9s cubic-bezier(.22,1,.36,1)}.reveal-section.is-visible{opacity:1;transform:none}.reveal-section:not(.is-visible) .album-item{opacity:0;transform:translateY(45rpx) rotate(-3deg)}
.privacy-overlay{position:fixed;inset:0;z-index:30;display:flex;align-items:center;justify-content:center;padding:40rpx;background:#071e22dd}.privacy-card{width:100%;max-width:670rpx;background:#164441;border:1rpx solid #8c9470;border-radius:32rpx;padding:45rpx 36rpx 16rpx;text-align:center}.privacy-title{font-size:37rpx;color:#efd6a3;margin-bottom:24rpx}.privacy-copy{font-size:25rpx;line-height:1.9;color:#d0dcc9}.privacy-link{background:none;color:#f0cf94;font-size:23rpx;text-decoration:underline;min-height:90rpx;padding:22rpx 0}.privacy-cancel{background:none;color:#cad7c5;font-size:24rpx;min-height:90rpx;padding:26rpx 0}
@keyframes photo-breathe{from{transform:scale(1)}to{transform:scale(1.035)}}@keyframes joy-fall{0%{transform:translate3d(0,-10vh,0) rotate(-25deg);opacity:0}12%{opacity:.36}75%{opacity:.25}100%{transform:translate3d(var(--sway),110vh,0) rotate(170deg);opacity:0}}@keyframes stamp-rock{0%,85%,100%{transform:rotate(-7deg)}90%{transform:rotate(2deg)}95%{transform:rotate(-11deg)}}@keyframes stamp-burst{0%{transform:translateX(30rpx) scale(.5);opacity:0}20%{opacity:1}100%{transform:translateX(180rpx) scale(.7);opacity:0}}@keyframes thread-drop{0%,100%{transform:translateY(0);opacity:.35}60%{transform:translateY(28rpx);opacity:1}}
.still .joy-snow,.still .stamp-sparks{display:none}.still .hero-photo,.still .joy-stamp,.still .scroll-thread::after{animation:none}.still .reveal-section,.still .album-item{opacity:1!important;transform:none!important;transition:none!important}.still .names-details::after{transform:scaleX(1);transition:none}.paused .snow-piece,.paused .hero-photo,.paused .joy-stamp,.paused .scroll-thread::after{animation-play-state:paused}
@media(prefers-reduced-motion:reduce){.joy-snow,.stamp-sparks{display:none}.hero-photo,.joy-stamp,.scroll-thread::after{animation:none}.reveal-section,.album-item{opacity:1!important;transform:none!important;transition:none!important}.names-details::after{transform:scaleX(1);transition:none}}
/* Override the style-v2 button's fixed default width inside invitation layouts. */
button.invitation-button,button.copy-address{width:100%!important}
button.hero-cta{width:calc(100% - 200rpx)!important}
button.distance-button{width:164rpx!important}
button.privacy-link,button.privacy-cancel,.privacy-card button.primary-btn{width:100%!important}.route-button[disabled]{opacity:.75;color:#183c38;background:#e5c58e}.route-button .button-title{font-size:26rpx}.route-button .button-subtitle{font-size:17rpx}
/* Photo books and a wedding-day time thread. */
.album-books{display:grid;grid-template-columns:1fr 1fr;gap:34rpx 24rpx}.album-book{display:block;text-align:left;background:transparent;padding:0;margin:0;min-width:0;width:100%!important;color:#eddbb7;white-space:normal}.book-feature{grid-column:1 / -1}.book-photo{position:relative;overflow:hidden;border:7rpx solid #e4cfab;border-radius:8rpx;background:#2a514c}.book-photo image{display:block;width:100%;height:250rpx}.book-feature .book-photo image{height:390rpx}.book-number{position:absolute;left:14rpx;top:10rpx;background:#173d3dd9;border:1rpx solid #e1c99888;color:#f5deaf;padding:3rpx 12rpx;font-size:22rpx;font-family:Georgia,serif}.book-open{position:absolute;right:14rpx;bottom:14rpx;background:#173d3dea;padding:8rpx 15rpx;border-radius:30rpx;font-size:20rpx;color:#f4dfb4}.book-label{display:flex;justify-content:space-between;align-items:center;gap:8rpx;padding-top:18rpx;line-height:1.6}.book-label .serif{font-size:30rpx;letter-spacing:2rpx}.book-count{color:#c7caaa;font-size:20rpx;white-space:nowrap}.book-subtitle{font-size:23rpx;color:#bfcfbf;margin-top:4rpx}.schedule-date{font-size:22rpx;color:#c9d4c2;margin-top:-25rpx;margin-bottom:32rpx;line-height:1.9}.guest-arrival{border-radius:18rpx;background:#e9d6af;color:#24463f;padding:28rpx 30rpx 0;position:relative;border:1rpx solid #f5e4c6}.arrival-heading{display:flex;align-items:center;justify-content:space-between;font-size:29rpx;letter-spacing:2rpx}.arrival-seal{border:1rpx solid #a74433;color:#a74433;padding:0 6rpx;font-size:30rpx;transform:rotate(-6deg)}.arrival-times{display:flex;align-items:center;justify-content:space-between;padding:28rpx 6rpx}.arrival-times>view{text-align:center}.arrival-time{display:block;font:58rpx/1.3 Georgia,serif;color:#163d38;letter-spacing:1rpx}.arrival-label{display:block;font-size:22rpx;margin-top:7rpx}.arrival-thread{color:#a68758;font-size:36rpx}.arrival-place{display:flex;justify-content:space-between;gap:8rpx;align-items:center;min-height:94rpx!important;width:100%!important;border-top:1rpx dashed #ab916a;background:transparent;color:#27493e;padding:20rpx 0;margin:0;font-size:22rpx;text-align:left}.arrival-place text{font-size:20rpx;white-space:nowrap}.schedule-phase{padding-top:50rpx}.phase-heading{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-bottom:28rpx}.phase-title{font-size:37rpx;letter-spacing:3rpx;color:#f0d4a3;display:flex;align-items:center;gap:18rpx}.phase-number{font-family:Georgia,serif;font-size:21rpx;letter-spacing:1rpx;color:#d2b181;border:1rpx solid #b9926399;border-radius:50%;width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center}.phase-subtitle{font-size:20rpx;color:#c0cbb9;margin-top:8rpx;letter-spacing:1rpx}.phase-place{flex-shrink:0;width:auto!important;min-width:150rpx;margin:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;padding:14rpx 18rpx;border:1rpx solid #8c9775;border-radius:50rpx;background:#204b45;color:#e9d6ad;font-size:22rpx}.schedule-event{display:flex;gap:24rpx;position:relative}.event-clock{width:118rpx;flex-shrink:0;text-align:right;font:35rpx/1.4 Georgia,serif;color:#e5c58e;padding-top:1rpx}.event-clock>text{display:block}.event-clock .event-end{font-size:25rpx;line-height:1.6}.event-clock .event-time-note{font-family:inherit;font-size:20rpx;line-height:1.6;color:#c2cbb9}.event-copy{position:relative;flex:1;min-width:0;padding:0 0 35rpx 28rpx;border-left:1rpx solid #8b987455}.event-copy::before{content:'';position:absolute;width:9rpx;height:9rpx;border:3rpx solid #123d40;border-radius:50%;background:#d3b17a;left:-8rpx;top:14rpx;box-shadow:0 0 0 1rpx #b69a6599}.event-title{font-size:29rpx;line-height:1.7;color:#f2dec0}.event-detail{font-size:23rpx;line-height:1.9;color:#c8d4c4;margin-top:7rpx}.event-highlight .event-copy::before{background:#d66f50;box-shadow:0 0 0 5rpx #a7443330}.event-highlight .event-title{color:#f3d199}.event-highlight .event-clock{color:#f3d199}.schedule-event:last-child .event-copy{padding-bottom:10rpx;border-left-color:transparent}.schedule-note{margin-top:35rpx;padding:28rpx 0;border-top:1rpx dashed #8b987455;font-size:22rpx;line-height:1.9;color:#c4cfbb}.schedule-note .serif{display:block;margin-top:12rpx;font-size:28rpx;color:#e8cda0;letter-spacing:3rpx}.venue-room{display:inline-block;font-size:24rpx;color:#e9cb96;border-bottom:1rpx solid #b9936066;margin-top:14rpx;padding-bottom:4rpx}.place-note{font-size:21rpx;color:#d9c196;line-height:1.8;margin-top:12rpx}

/* An always-on joy seal and quiet scroll details. */
.joy-emblem{display:flex;align-items:center;gap:18rpx;color:#d9bd90;flex-shrink:0}.emblem-date{font-size:20rpx;letter-spacing:4rpx;writing-mode:vertical-rl}.emblem-seal{position:relative;display:flex;align-items:center;justify-content:center;width:66rpx;height:72rpx;background:#9f4032;border:2rpx solid #daa271;border-radius:10rpx 4rpx 10rpx 4rpx;color:#ffe1af;font-size:46rpx;transform:rotate(-7deg)}.emblem-seal::after{content:'';position:absolute;inset:-4px;border:2rpx solid #c693604d;border-radius:14rpx 8rpx 14rpx 8rpx;animation:seal-glow 4s ease-in-out infinite}
.book-photo::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 32%,#fff5d73b 49%,transparent 66%);transform:translateX(-150%);pointer-events:none}.album-book:active .book-photo{transform:scale(.985)}.book-photo{transition:transform .45s}.book-open{border:2rpx solid #ead4a744;transition:background .3s}.book-label{position:relative;padding-bottom:16rpx}.book-label::after{content:'';position:absolute;left:0;right:0;bottom:0;height:2rpx;background:linear-gradient(90deg,#ba9163,transparent);transform:scaleX(0);transform-origin:left;transition:transform 1.1s .15s}.section-kicker::after{content:'';display:block;height:2rpx;flex:1;max-width:160rpx;background:linear-gradient(90deg,#b29465,transparent);transform:scaleX(0);transform-origin:left;transition:transform 1.2s .2s}.event-highlight .event-copy::before{animation:time-pulse 3.5s ease-in-out infinite}.invitation-button .button-arrow{animation:invite-arrow 4s ease-in-out infinite}.postmark{animation:postmark-sway 8s ease-in-out infinite}.line-ornament{animation:ornament-glow 5s ease-in-out infinite}
@keyframes seal-glow{0%,100%{opacity:.4}50%{opacity:1}}@keyframes book-glint{to{transform:translateX(150%)}}@keyframes time-pulse{0%,100%{box-shadow:0 0 0 6rpx #a7443330}50%{box-shadow:0 0 0 14rpx #a7443308}}@keyframes invite-arrow{0%,75%,100%{transform:translate(0,0)}85%{transform:translate(4rpx,-2px)}}@keyframes postmark-sway{0%,100%{transform:rotate(10deg)}50%{transform:rotate(4deg)}}@keyframes ornament-glow{0%,100%{opacity:.65}50%{opacity:1}}
.is-visible .section-kicker::after,.album-book.is-visible .book-label::after{transform:scaleX(1)}.album-book.is-visible .book-photo::after{animation:book-glint 1.5s .2s ease-out both}.book-photo image{transition:transform .8s}.album-book:not(.is-visible) .book-photo image{transform:scale(1.05)}.book-feature .book-photo{border-color:#d9b681}.book-subtitle{margin-top:10rpx}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;padding:62rpx 26rpx calc(14rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#123d4000,#123d40eb 42%,#123d40 75%);z-index:10;transition:opacity .38s ease;pointer-events:none}.nav-track{position:relative;display:flex;pointer-events:auto}.bottom-nav.nav-quiet{opacity:.28}.bottom-nav button{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:6rpx;padding:18rpx 0 10rpx;min-height:100rpx!important;width:auto!important;background:transparent;color:#a8c0b4;margin:0;font-size:25rpx;letter-spacing:5rpx;line-height:1.3;transition:color .4s,background .4s}.nav-number{font:18rpx/1.2 Georgia,serif;letter-spacing:3rpx;opacity:.55;transition:opacity .4s}.bottom-nav button::before{content:'';position:absolute;top:4rpx;left:calc(50% - 4rpx);width:8rpx;height:8rpx;transform:rotate(45deg);background:#e8c287;opacity:0;transition:opacity .4s}.bottom-nav .active{color:#f5dbad;background:radial-gradient(ellipse at 50% 110%,#e5c58e16,transparent 70%)}.bottom-nav .active::before{opacity:1}.bottom-nav .active .nav-number{opacity:.95}
button.distance-button{width:132rpx!important;min-height:130rpx!important;padding:14rpx 4rpx 10rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;background:linear-gradient(145deg,#315a50,#21483f);border:1rpx solid #b89a655e;border-radius:20rpx;color:#f4dfb2;box-shadow:inset 0 1rpx 0 #e5c58e22;line-height:1.2}.distance-action{font-size:21rpx;letter-spacing:2rpx}.compass-icon{position:relative;width:48rpx;height:48rpx;border-radius:50%;border:1rpx solid #c5ab73;display:flex;align-items:center;justify-content:center;color:#f0cf94}.compass-icon::before{content:'';position:absolute;inset:5rpx;border:1rpx dashed #c5ab7359;border-radius:50%}.compass-icon text{font-size:34rpx;line-height:1;transform:rotate(20deg);transition:transform .5s}.distance-button:active .compass-icon text{transform:rotate(120deg)}.is-locating .compass-icon{animation:halo-orbit 2s linear infinite}.distance-note{line-height:1.7}.distance-card{gap:24rpx}.distance-number{font-size:29rpx;line-height:1.5}.distance-button[disabled]{background:#274d44;color:#dbcca9}

.paused view,.paused text,.paused button,.paused image,.paused view::before,.paused view::after{animation-play-state:paused!important}
.still view,.still text,.still button,.still image,.still view::before,.still view::after{animation:none!important;transition:none!important}.still .book-label::after,.still .section-kicker::after{transform:scaleX(1)}.still .bottom-nav.nav-quiet{opacity:1}
@media(prefers-reduced-motion:reduce){view,text,button,image,view::before,view::after{animation:none!important;transition:none!important}.bottom-nav.nav-quiet{opacity:1}.book-label::after,.section-kicker::after{transform:scaleX(1)}}

/* Rose vines link the album covers, with a larger stem beneath the featured book. */
.album-books{row-gap:100rpx}.album-book{position:relative;overflow:visible}.book-feature{margin-bottom:60rpx}.book-vine{position:absolute;left:-10rpx;right:-10rpx;bottom:-91rpx;height:84rpx;pointer-events:none;opacity:0;transition:opacity 1.2s .25s}.book-vine image{width:100%;height:100%;display:block}.is-visible .book-vine{opacity:.9}.book-vine.vine-reverse{transform:scaleX(-1)}.book-feature .book-vine{left:0;right:0;bottom:-158rpx;height:148rpx}.still .book-vine{opacity:.9}@media(prefers-reduced-motion:reduce){.book-vine{opacity:.9;transition:none}}

/* A small embedded Song-style title face. */
.hero-title,.section-title,.letter-title,.farewell-title{font-family:"Wedding Display","Songti SC","STSong",serif;font-weight:400}
.hero-title{bottom:34rpx;font-size:88rpx;letter-spacing:8rpx;line-height:1.4;color:#ffe3a9;text-shadow:0 2rpx 1rpx #a2784166,0 6rpx 22rpx #0e211bdd}
.title-words{display:flex;align-items:baseline;justify-content:center;gap:12rpx;padding-bottom:14rpx}
.title-last{display:inline-block;transform:translateY(9rpx)}
.title-dedication{display:block;font:16rpx/1.5 Georgia,serif;letter-spacing:6rpx;color:#dfc697;padding-left:6rpx;text-shadow:none}
.section-title{font-size:51rpx;letter-spacing:2rpx;line-height:1.65;color:#f4e4c7}
.story-title{margin-bottom:42rpx;line-height:1.5;letter-spacing:4rpx}
.story-first{font-size:59rpx}
.story-last{position:relative;padding-left:58rpx;margin-top:8rpx;font-size:72rpx;color:#eac68e}
.story-last::before{content:'';position:absolute;left:0;top:52%;height:1rpx;width:35rpx;background:#bd9b6c}
.title-punctuation{font-size:.56em;color:#c1ae8b;letter-spacing:0}
.letter-title{font-size:40rpx;letter-spacing:2rpx;color:#f1d6ab}
.bottom-nav button{font-size:24rpx;letter-spacing:4rpx}

/* Seven chapters retain a 44px target at a 320px viewport. */
.bottom-nav{padding-left:10rpx;padding-right:10rpx}.bottom-nav button{font-size:26rpx;letter-spacing:2rpx}

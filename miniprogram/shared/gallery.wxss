.gallery-page{padding:48rpx 32rpx calc(50rpx + env(safe-area-inset-bottom))}.gallery-intro{padding:20rpx 12rpx 50rpx}.gallery-eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#d8bd89}.gallery-title{font-size:58rpx;letter-spacing:6rpx;color:#f4dfbc;margin:16rpx 0}.gallery-subtitle{font-size:25rpx;color:#d0d9c9}.gallery-hint{font-size:21rpx;color:#b7cabb;margin-top:28rpx}.gallery-grid{display:grid;grid-template-columns:1fr;gap:30rpx 20rpx;align-items:start}.gallery-wide{grid-column:1 / -1}.gallery-photo .gallery-original{display:block;width:100%;background:#315854;border:6rpx solid #e4cfab;border-radius:6rpx;min-height:200rpx}.gallery-caption{display:flex;justify-content:space-between;color:#dcc296;font-size:18rpx;padding:10rpx 4rpx}.gallery-ending{text-align:center;font-size:28rpx;letter-spacing:3rpx;margin:65rpx 0 25rpx;color:#e9cd9f}button.gallery-return,button.gallery-missing{width:100%!important;min-height:88rpx;border-radius:50rpx;border:1rpx solid #a3926d;background:transparent;color:#f2ddb8;font-size:24rpx;line-height:1.7;padding:22rpx}.gallery-missing{padding:60rpx 20rpx}.gallery-missing button{margin-top:35rpx}

/* Photos rise into their mounts once, with a fine gold caption rule. */
.gallery-photo{opacity:0;transform:translateY(28rpx);transition:opacity .65s ease,transform .8s ease}.gallery-photo.photo-visible{opacity:1;transform:none}.gallery-caption{position:relative;padding:18rpx 4rpx}.gallery-caption::after{content:'';position:absolute;left:0;right:0;bottom:0;height:1rpx;background:linear-gradient(90deg,#d0ab73,transparent);transform:scaleX(0);transform-origin:left;transition:transform 1s .2s}.photo-visible .gallery-caption::after{transform:scaleX(1)}.gallery-intro{animation:gallery-open .65s ease both}@keyframes gallery-open{from{opacity:0;transform:translateY(15rpx)}to{opacity:1;transform:none}}.paused view{animation-play-state:paused!important}@media(prefers-reduced-motion:reduce){.gallery-photo,.gallery-intro{opacity:1;transform:none;animation:none;transition:none}.gallery-caption::after{transform:scaleX(1);transition:none}}

/* One transparent rose stem joins neighbouring photographs. It never receives touch events. */
.gallery-grid{gap:8rpx}.gallery-photo{position:relative;padding:0 8rpx 0 0}.gallery-photo.vine-reverse{padding:0 0 0 8rpx}.gallery-photo .gallery-original{border-width:4rpx;border-color:#dec39a;box-shadow:0 12rpx 28rpx #062b292d}.gallery-caption{padding:18rpx 4rpx 4rpx}.gallery-caption::after{display:none}.vine-bridge{height:228rpx;margin:0 -12rpx -8rpx;pointer-events:none;position:relative}.vine-unfurl{position:absolute;inset:0;opacity:0;clip-path:inset(0 100% 0 0);transform:translateY(-8rpx);transition:clip-path 1.7s cubic-bezier(.22,.61,.36,1) .15s,opacity .8s .1s,transform 1.6s ease}.vine-visible .vine-unfurl{opacity:.92;clip-path:inset(0 0 0 0);transform:translateY(0)}.vine-reverse .vine-bridge{transform:scaleX(-1)}.vine-art{display:block;width:100%;height:228rpx;animation:rose-sway 8s ease-in-out infinite;transform-origin:50% 40%}.vine-reverse .vine-art{animation-delay:-3s}.paused .vine-art{animation-play-state:paused!important}@keyframes rose-sway{0%,100%{transform:rotate(-.65deg) translateY(0)}50%{transform:rotate(.65deg) translateY(3rpx)}}@media(prefers-reduced-motion:reduce){.vine-unfurl{clip-path:none!important;opacity:.92;transform:none;transition:none}.vine-art{animation:none}}

.gallery-status{color:#dcc296;font-size:23rpx;text-align:center;padding:0 0 30rpx}.gallery-frame{position:relative;background:#234c49;border-radius:6rpx;overflow:hidden}.gallery-wait{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;color:#d2b789;font-size:54rpx}.gallery-retry,.gallery-photo-retry{border:1rpx solid #a3926d!important;border-radius:12rpx;background:#234c49;color:#ead7b6;font-size:23rpx;padding:24rpx;line-height:1.8}.gallery-retry{margin-bottom:30rpx}.gallery-photo-retry{position:absolute;left:24rpx;right:24rpx;top:40%;width:auto!important}.gallery-frame .gallery-original{box-sizing:border-box;position:relative;z-index:1}.gallery-photo-retry{z-index:2}

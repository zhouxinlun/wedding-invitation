<template name="wedding-gallery">
  <view class="gallery-page {{pageVisible ? '' : 'paused'}}">
    <view wx:if="{{missing}}" class="gallery-missing"><text>这本相册暂时未能打开。</text><button bindtap="returnToInvite">返回请柬 ↗</button></view>
    <block wx:else><view class="gallery-intro"><view class="gallery-eyebrow">OUR MOMENTS · {{photos.length}} 帧心动</view><view class="gallery-title serif">{{album.title}}</view><view class="gallery-subtitle">{{album.subtitle}}</view><view class="gallery-hint">轻触放大 · 左右滑动看下一张</view></view>
    <view wx:if="{{mediaLoading}}" class="gallery-status">正在翻开这一页心动…</view><button wx:if="{{mediaError}}" class="gallery-retry" bindtap="retryAlbumMedia">相册暂未展开 · 轻触重试 ↗</button>
    <view class="gallery-grid"><view wx:for="{{photos}}" wx:key="file" id="photo-{{index}}" class="gallery-photo gallery-reveal {{revealed['photo-' + index] || !revealReady ? 'photo-visible' : ''}} {{item.width > item.height ? 'gallery-wide' : ''}} {{index % 2 ? 'vine-reverse' : ''}}"><view class="gallery-frame" style="min-height:{{item.loaded ? 0 : item.width ? 650 * item.height / item.width : 600}}rpx"><image wx:if="{{item.url && !item.failed}}" class="gallery-original" src="{{item.url}}" mode="widthFix" lazy-load bindload="photoLoaded" binderror="photoFailed" bindtap="previewPhoto" data-index="{{index}}" data-src="{{item.url}}" aria-label="放大查看{{item.title}}"/><view wx:if="{{!item.loaded && !item.failed}}" class="gallery-wait" aria-hidden="true">♡</view><button wx:if="{{item.failed}}" class="gallery-photo-retry" bindtap="retryAlbumMedia">这份心动正在路上 · 轻触，重新展开 ↗</button></view><view class="gallery-caption"><text>{{index + 1}} / {{photos.length}}</text><text>{{item.label}}</text></view><view wx:if="{{index < photos.length - 1}}" id="vine-{{index}}" class="vine-bridge gallery-reveal {{revealed['vine-' + index] || !revealReady ? 'vine-visible' : ''}}" aria-hidden="true"><view class="vine-unfurl"><image class="vine-art" src="/assets/{{item.vine}}" mode="aspectFit" lazy-load/></view></view></view></view>
    <view class="gallery-ending serif">心动不止此刻，欢喜还有余生。</view><button class="gallery-return" bindtap="returnToInvite">合上相册，继续看请柬 ↗</button></block>
  </view>
</template>
